# Copy to backend/.env and fill in. .env is gitignored; this template is not.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=namoa

# Origins allowed to call the API ("*" for local development)
CORS_ORIGINS=*

# Enquiry form email (https://resend.com)
#   RESEND_API_KEY      a Resend API key with send permission
#   ENQUIRY_TO_EMAIL    inbox that receives enquiries (comma-separate several)
#   ENQUIRY_FROM_EMAIL  sender on a domain verified in Resend. Resend's shared
#                       test sender, onboarding@resend.dev, only delivers to the
#                       Resend account owner, so enquirer acknowledgements need a
#                       verified domain before they arrive.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=NAMOA Website <onboarding@resend.dev>
